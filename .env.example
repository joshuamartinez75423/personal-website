# Copy to .env.local for local dev, and set the same values in your host's
# environment settings (on Vercel: Settings -> Environment Variables).
# Never commit real keys — .gitignore covers .env and .env.*.

# Required. Powers the /api/chat assistant. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only needed if you switch the chatbot back to Claude
# (see the note at the bottom of app/api/chat/route.ts).
ANTHROPIC_API_KEY=

# Optional. Set once a custom domain is attached, e.g. https://joshuamartinez.dev
# Without it, app/layout.tsx falls back to Vercel's deployment URL, and to
# http://localhost:3000 during `next dev`.
NEXT_PUBLIC_SITE_URL=
